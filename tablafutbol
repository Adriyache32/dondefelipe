                <td>1</td>
                <td>4</td>
                <td>4</td>
                <td class="dg">0</td>
                <td>0</td>
                <td>1</td>
                <td class="pts-box">1</td>
            </tr>
            <tr>
                <td class="pos">3</td>
                <td class="team-name">Segundo Medio</td>
                <td>0</td>
                <td>0</td>
                <td>0</td>
                <td class="dg">0</td>
                <td>0</td>
                <td>0</td>
                <td class="pts-bold">0</td>
            </tr>
            <tr>
                <td class="pos">4</td>
                <td class="team-cell">Tercero Medio</td>
                <td>0</td>
                <td>0</td>
                <td>0</td>
                <td class="dg-cell">0</td>
                <td>0</td>
                <td>0</td>
                <td class="pts-bold">0</td>
            </tr>
            <tr>
                <td class="pos">5</td>
                <td class="team-cell">Cuarto Medio</td>
                <td>0</td>
                <td>0</td>
                <td>0</td>
                <td class="dg-cell">0</td>
                <td>0</td>
                <td>0</td>
                <td class="pts-bold">0</td>
            </tr>
            <tr>
                <td class="pos">6</td>
                <td class="team-cell">Séptimo Básico</td>
