<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tabla de Posiciones 2026</title>
    <style>
        :root {
            --pitch-green: #1b4d3e;
            --grass: #2d5a27;
            --gold: #ffd700;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), 
                        url('https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&q=80&w=1000') center/cover;
            color: white;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 800px;
            background: rgba(0, 0, 0, 0.8);
            border-radius: 12px;
            padding: 25px;
            border: 2px solid var(--gold);
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }

        h2 {
            text-align: center;
            letter-spacing: 2px;
            color: var(--gold);
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            font-size: 0.8rem;
            color: #888;
            padding: 10px;
            border-bottom: 1px solid #333;
            text-transform: uppercase;
        }

        td {
            padding: 15px 10px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .team-name {
            text-align: left;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .pos { color: var(--gold); font-weight: 800; width: 30px; }

        .pts-box {
            background: rgba(255, 215, 0, 0.2);
            color: var(--gold);
            font-weight: 900;
            border-radius: 4px;
        }

        tr:hover { background: rgba(255,255,255,0.05); }

        .dg { color: #4ade80; }
    </style>
</head>
<body>

<div class="container">
    <h2>🏆 Posiciones San Agustín 2026</h2>
    <table>
        <thead>
            <tr>
