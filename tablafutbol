                <th>GF</th>
                <th>GC</th>
                <th>DG</th>
                <th>PG</th>
                <th>PE</th>
                <th class="pts-box">PTS</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="pos">1</td>
                <td class="team-name">Primero Medio</td>
                <td>1</td>
                <td>4</td>
                <td>4</td>
                <td class="dg">0</td>
                <td>0</td>
                <td>1</td>
                <td class="pts-box">1</td>
            </tr>
            <tr>
                <td class="pos">2</td>
